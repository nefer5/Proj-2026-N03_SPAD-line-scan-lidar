+.workspace, .page-heading { max-width:none; }
+
+/* A short viewport has one scroll owner for the full parameter editor. */
+@media(max-height:700px) {
+  .parameter-panel { display:block; overflow:auto; max-height:calc(100dvh - 32px); overscroll-behavior:contain; }
+  .parameter-groups { overflow:visible; max-height:none; }
+  .parameter-head { padding:10px 14px; }
+  .parameter-head .label-row { margin-bottom:6px; }
+  .parameter-head .primary-actions .primary { padding:7px; }
+  .parameter-head .fold-actions { margin-top:6px; }
+  .parameter-head .defaults-note { margin-top:5px; }
+  .parameter-panel .config-tools { padding:6px 14px; }
+  .parameter-footer { padding:7px 14px; }
