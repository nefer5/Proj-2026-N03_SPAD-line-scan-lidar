2.87818377449003, "height": 21.6, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "hachure", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": "b1o", "roundness": null, "seed": 1136146308, "version": 33, "versionNonce": 2112097284, "isDeleted": true, "boundElements": [], "updated": 1790884274598, "link": null, "locked": false, "text": "", "fontSize": 16, "fontFamily": 6, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "", "autoResize": false, "lineHeight": 1.35}, {"id": "tJiXUKLSi8AjoqYnC5cpt", "type": "frame", "x": 356.3327434959871, "y": 2020.152255463625, "width": 706.2070887237934, "height": 387.0327857054267, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": "b1p", "roundness": null, "seed": 1855815356, "version": 95, "versionNonce": 349393212, "isDeleted": false, "boundElements": [], "updated": 1790884303040, "link": null, "locked": false, "name": "成对成组的参数应该这样去打包布局"}, {"id": "on6Gg69EFxUyhwZsFPN8v", "type": "image", "x": 340.3810630108974, "y": 2518.655888098465, "width": 540, "height": 339, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "hachure", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": "b1q", "roundness": null, "seed": 198921660, "version": 36, "versionNonce": 862677308, "isDeleted": true, "boundElements": [], "updated": 1790884366405, "link": null, "locked": false, "status": "pending", "fileId": "ff4202c765d1c097fd157e59ebf6330427fc652a", "scale": [1, 1], "crop": null}, {"id": "2jEfqVAbf4Oh1sbmGNhgi", "type": "image", "x": 410.1183811019505, "y": 3257.518470775286, "width": 547, "height": 1045, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "hachure", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": "b1r", "roundness": null, "seed": 32154300, "version": 300, "versionNonce": 1440916100, "isDeleted": false, "boundElements": [{"id": "LlmAw0zLzEotCMTfPMJ-p", "type": "arrow"}], "updated": 1790885016844, "link": null, "locked": false, "status": "pending", "fileId": "58371d36a0b1a205ebff41b782fcdba0cd0e1960", "scale": [1, 1], "crop": null}, {"id": "2NON-QJxbxDxwdSMHWi9m", "type": "text", "x": 1049.6816126312117, "y": 2846.343580729925, "width": 871.3469096637615, "height": 162, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "hachure", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": "b1s", "roundness": null, "seed": 2015728260, "version": 536, "versionNonce": 1048990908, "isDeleted": false, "boundElements": [], "updated": 1790885313628, "link": null, "locked": false, "text": "把Tx能量和角度问题定义明确 \n1- 系统目标里要设定lidar线数(V方向通道数)\n2- 光源能量输入: 全角度的单脉冲功率(VCSEL) , 同时要自动根据线数平均推算出单角通道功率\n3- Tx发光归一化角域的参数只需要输入H方向数值, V方向自动按单通道的角度推算(UI上要显示); \n4- 单角度光斑的光场分布在这个模块直接用均匀处理, 默认光斑宽度=Tx H方向角通道宽度\n5- 收发的通道默认 H方向没有多通道, 纯沿V方向一维线阵定义.", "fontSize": 20, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "把Tx能量和角度问题定义明确 \n1- 系统目标里要设定lidar线数(V方向通道数)\n2- 光源能量输入: 全角度的单脉冲功率(VCSEL) , 同时要自动根据线数平均推算出单角通道功率\n3- Tx发光归一化角域的参数只需要输入H方向数值, V方向自动按单通道的角度推算(UI上要显示); \n4- 单角度光斑的光场分布在这个模块直接用均匀处理, 默认光斑宽度=Tx H方向角通道宽度\n5- 收发的通道默认 H方向没有多通道, 纯沿V方向一维线阵定义.", "autoResize": false, "lineHeight": 1.35}, {"id": "hrTNdF33Skdju7_IyB3ux", "type": "image", "x": 431.6575455076845, "y": 2751.731018489838, "width": 526, "height": 496, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "hachure", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": 