  "cards": [
    {
      "dot": "cyan",
      "title": "共享核心的输入边界",
      "items": [
        "B 先完成 Tx/场景/Rx 投影；独立 SPAD 直接构造探测面照明。",
        "照明在 PDE/FF 之前，以完整像素为参考面；候选雪崩与最终混合记录分开。",
        "C 复用 B 背景/光学数据，再按逐发角度和时序形成变化信号。"
      ]
    },
    {
      "dot": "emerald",
      "title": "状态与硬件信息边界",
      "items": [
        "Session 在同一事件时间线上维护器件恢复、读出窗口、TDC 容量和时间水位。",
        "C 注入 TraceDevice 与 FragmentAwareReadout；仍使用公共 Session。",
        "读出记录只暴露读出/TDC 身份；光学真值和器件诊断独立保存。"
      ]
    },
    {
      "dot": "violet",
      "title": "A 的分支与兼容层",
      "items": [
        "A 的事件模式通过 a_router 接入同一器件/读出核心；保留旧采样顺序。",
        "A 的 analytic_reference 分支直接计算和采样解析直方图，绕过事件 Session。",
        "A 的单角 Rx 预算与 B 的空间光学不同；共同函数共享不等于模型范围相同。"
      ]
    },
    {
      "dot": "amber",
      "title": "检查时需要保留的限制",
      "items": [
        "核心检查点恢复不等于 JobManager 能在进程崩溃后自动续算。",
        "C 当前仍跨列连续；完全复位为已确认待实施意图。",
        "B/C 原始测距不等于已标定 Pd/PFA；afterpulse、雪崩串扰和完整直方图硬件资源仍有限制。"
      ]
    }
  ]
