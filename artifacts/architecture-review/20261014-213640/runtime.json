  "cards": [
    {
      "dot": "cyan",
      "title": "从入口读代码",
      "items": [
        "start-dev.cmd → run.py → Uvicorn → api:app；服务绑定本机。",
        "网页共用曲线、直方图和扫描工作台组件；参数预览也调用 Python。",
        "A 支持同步 API，也支持 kind=a 后台任务；图中两种入口分开标示。"
      ]
    },
    {
      "dot": "emerald",
      "title": "任务与审计的实际边界",
      "items": [
        "JobManager 保存 YAML、实际配置、算法快照；worker 写 result.json，元数据存 SQLite。",
        "服务发现已停止的任务所有者后标 interrupted；不是自动崩溃续算。",
        "图中的箭头是调用或数据方向；响应沿 HTTP 原路返回。结果视图由 API 提供。"
      ]
    },
    {
      "dot": "violet",
      "title": "模块复用与预算分支",
      "items": [
        "experiments 是编排层，公共核心的内部关系见另一张核心链路图。",
        "simulator.py、readout.py、curves.py 等保留兼容导出；并非另外一套主模型。",
        "预算路径调用同一个 B 光学投影，并独立计算电热/输出容量；不运行完整事件采集。"
      ]
    },
    {
      "dot": "amber",
      "title": "审查范围与未完成项",
      "items": [
        "依据干净工作树 HEAD 354cb2e；节点附本地源码路径和行号。",
        "此图核对代码结构和调用关系，不替代数值验证或器件实测。",
        "roadmap：C 人工精细验收、C 列间完全复位、命名与参数跨平台审计仍待完成。"
      ]
    }
  ]
